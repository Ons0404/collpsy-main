generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id               Int           @id @default(autoincrement())
  userId           Int?
  administrateurId Int?
  expiresAt        DateTime
  utilisateur      utilisateur?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  administrateur   Administrateur? @relation(fields: [administrateurId], references: [id], onDelete: Cascade)
  
  @@map("session")
}
model ResetToken {
  id          Int         @id @default(autoincrement())
  token       String      @unique
  expiresAt   DateTime
  userId      Int         @unique
  utilisateur utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reset_token")
}

model utilisateur {
  id                    Int             @id @default(autoincrement())
  nom                   String
  prenom                String
  email                 String          @unique
  mot_de_passe          String
  date_inscription      DateTime        @default(now())
  date_naissance        DateTime?
  adresse               String?
  ville                 String?
  code_postal           String?
  telephone             String?
  role                  RoleEnum
  civilite              CiviliteEnum
  statut                Boolean         @default(false)
  avatar                Bytes?
  notifications         Notification[]
  conversations         Conversation[]  @relation("UtilisateurToConversation")
  aiConversations       AIConversation[]
  etudiant              Etudiant?
  psychologue           Psychologue?
  rendezVous            RendezVous[]
  resetTokens           ResetToken?
  sessions              Session[]
  messages              Message[]       @relation("Messages")
  userMessagesSent      UserMessage[]   @relation("UserMessageSender")
  userMessagesReceived  UserMessage[]   @relation("UserMessageRecipient")
  reclamations          Reclamation[]   @relation

  @@map("utilisateur")
}
model Reclamation {
  id              Int       @id @default(autoincrement())
  categorie       String
  description     String    @db.Text
  dateCreation    DateTime  @default(now())
  dateResolution  DateTime? 
  status          String    @default("NOUVELLE") // NOUVELLE, EN_TRAITEMENT, RÉSOLUE
  isUrgent        Boolean   @default(false)
  pieceJointe     String?   // Nom du fichier joint
  utilisateurId   Int      // Peut être null si réclamation anonyme
  roleUtilisateur String?   // ETUDIANT, PSYCHOLOGUE, ANONYME, etc.
  
  // Relations
  utilisateur     utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)
  
  @@index([utilisateurId])
  @@index([status])
  @@map("reclamations")
}

model Psychologue {
  id_psychologue    Int             @id
  cin               String          @unique
  titre             String
  etablissement     String
  adresse_cabinet   String?
  intitule_diplome  String
  date_obtention    DateTime
  mode_consultation String?
  photo_diplome     Bytes?
  consultations     Consultation[]
  disponibilites    Disponibilite[]
  utilisateur       utilisateur     @relation(fields: [id_psychologue], references: [id], onDelete: Cascade)
  rendezVous        RendezVous[]
  rapports          Rapport[]       @relation("PsychologueToRapport")
  conversations     Conversation[]  @relation("PsychologueToConversation")

  @@map("psychologue")
}

model Etudiant {
  id_etudiant           Int            @id
  numero_carte_etudiant String         @unique
  niveau                String
  etablissement         String
  utilisateur           utilisateur    @relation(fields: [id_etudiant], references: [id], onDelete: Cascade)
  consultations         Consultation[]

  aiConversations       AIConversation[]
  evaluations           Evaluation[]
  fichesPatients        FichePatient?
  rapports              Rapport[]
  resultatsTests        ResultatTest[]

  @@map("etudiant")
}

model Disponibilite {
  id             Int              @id @default(autoincrement())
  id_psychologue Int
  date           DateTime
  heure_debut    String
  heure_fin      String
  type           TypeConsultation
  est_disponible Boolean          @default(true)
  psychologue    Psychologue      @relation(fields: [id_psychologue], references: [id_psychologue], onDelete: Cascade)

  @@map("disponibilite")
}

model Administrateur {
  id           Int    @id @default(autoincrement())
  email        String @unique
  mot_de_passe String
   notifications         Notification[]
  sessions              Session[]
  @@map("administrateur")
}

model RendezVous {
  id             Int           @id @default(autoincrement())
  id_psychologue Int
  id_utilisateur Int
  date           DateTime
  heure_debut    String
  heure_fin      String
  type           String
  statut         String        @default("en attente")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  notes          String?
  consultation   Consultation?
  messages       Message[]     @relation("Messages")
  userMessages   UserMessage[]
  psychologue    Psychologue   @relation(fields: [id_psychologue], references: [id_psychologue], onDelete: Cascade)
  utilisateur    utilisateur   @relation(fields: [id_utilisateur], references: [id], onDelete: Cascade)
  notifications  Notification[]

  @@index([id_psychologue])
  @@index([id_utilisateur])
  @@index([date])
  @@map("rendez_vous")
}

model Message {
  id               String         @id @default(uuid())
  consultationId   Int?
  senderId         Int
  content          String         @db.Text
  sentAt           DateTime       @default(now())
  readAt           DateTime?
  rendezVousId     Int?
  conversationId   Int?
  aiConversationId Int?
  isAiMessage      Boolean        @default(false)
  consultation     Consultation?  @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  sender           utilisateur    @relation("Messages", fields: [senderId], references: [id], onDelete: Cascade)
  rendezVous       RendezVous?    @relation("Messages", fields: [rendezVousId], references: [id], onDelete: Cascade)
  conversation     Conversation?  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  aiConversation   AIConversation? @relation(fields: [aiConversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model UserMessage {
  id             String        @id @default(uuid())
  senderId       Int
  recipientId    Int
  content        String        @db.Text
  sentAt         DateTime      @default(now())
  readAt         DateTime?
  conversationId Int?
  rendezVousId   Int?
  sender         utilisateur   @relation("UserMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient      utilisateur   @relation("UserMessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  rendezVous     RendezVous?   @relation(fields: [rendezVousId], references: [id], onDelete: Cascade)
  notifications  Notification[]

  @@map("user_messages")
}

model Conversation {
  id             Int           @id @default(autoincrement())
  userId         Int
  psychologistId Int?
  consultationId Int?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  utilisateur    utilisateur   @relation("UtilisateurToConversation", fields: [userId], references: [id], onDelete: Cascade)
  psychologue    Psychologue?  @relation("PsychologueToConversation", fields: [psychologistId], references: [id_psychologue], onDelete: SetNull)
  
  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  messages       Message[]
  userMessages   UserMessage[]
  notifications  Notification[]
 @@unique([userId, psychologistId]) // Assure qu'une seule conversation existe entre un étudiant et un psychologue
  @@map("conversations")
}

model AIConversation {
  id            Int         @id @default(autoincrement())
  userId        Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  promptId      Int?        // Added to link AI conversations to prompts
  etudiantId    Int?
  messages      Message[]
  utilisateur   utilisateur @relation(fields: [userId], references: [id], onDelete: Cascade)
  etudiant      Etudiant?   @relation(fields: [etudiantId], references: [id_etudiant], onDelete: SetNull)
  prompt        Prompt?     @relation(fields: [promptId], references: [id], onDelete: SetNull)

  @@map("ai_conversations")
}

// Added Prompt model to support AI conversations
model Prompt {
  id              Int             @id @default(autoincrement())
  title           String
  content         String          @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  aiConversations AIConversation[]

  @@map("prompts")
}

model Consultation {
  id             Int                @id @default(autoincrement())
  etudiantId     Int
  psychologueId  Int
  status         ConsultationStatus
  type           TypeConsultation
  startTime      DateTime
  endTime        DateTime
  notes          String?            @db.Text
  summary        String?            @db.Text
  roomId         String?            @unique
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  fichePatientId String?
  rendezVousId   Int                @unique
  etudiant       Etudiant           @relation(fields: [etudiantId], references: [id_etudiant], onDelete: Cascade)
  psychologue    Psychologue        @relation(fields: [psychologueId], references: [id_psychologue], onDelete: Cascade)
  fichePatient   FichePatient?      @relation(fields: [fichePatientId], references: [id], onDelete: SetNull)
  rendezVous     RendezVous         @relation(fields: [rendezVousId], references: [id], onDelete: Cascade)
  conversations  Conversation[]
  evaluations    Evaluation[]
  messages       Message[]

  @@map("consultations")
}

model FichePatient {
  id                        String         @id @default(uuid())
  etudiantId                Int            @unique
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  antecedentsMedicaux       String?        @db.Text
  antecedentsPsychologiques String?        @db.Text
  allergies                 String?        @db.Text
  medicamentsActuels        String?        @db.Text
  traitementsEnCours        String?        @db.Text
  symptomesActuels          String?        @db.Text
  objectifsTherapie         String?        @db.Text
  notesPsychologue          String?        @db.Text
  historiqueConsultations   String?        @db.Text
  etudiant                  Etudiant       @relation(fields: [etudiantId], references: [id_etudiant], onDelete: Cascade)
  consultations             Consultation[]

  @@map("fiches_patients")
}

model Evaluation {
  id             String       @id @default(uuid())
  consultationId Int
  etudiantId     Int
  satisfaction   Int          @default(0)
  empathie       Int?         @default(0)
  ecoute         Int?         @default(0)
  comprehension  Int?         @default(0)
  recommandation Int?         @default(0)
  commentaires   String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  etudiant       Etudiant     @relation(fields: [etudiantId], references: [id_etudiant], onDelete: Cascade)

  @@map("evaluations")
}

model TestPsychologique {
  id           String         @id @default(uuid())
  titre        String
  description  String?        @db.Text
  categorie    CategorieTest
  interpretation String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  dureeEstimee Int
  questions    Question[]
  resultats    ResultatTest[]

  @@map("tests_psychologiques")
}

model Question {
  id                  String               @id @default(uuid())
  testId              String
  texte               String               @db.Text
  ordre               Int
  type                TypeQuestion
  test                TestPsychologique    @relation(fields: [testId], references: [id], onDelete: Cascade)
  optionsReponse      OptionReponse[]
  reponsesUtilisateur ReponseUtilisateur[]

  @@map("questions")
}

model OptionReponse {
  id         String               @id @default(uuid())
  questionId String
  texte      String
  valeur     Int
  question   Question             @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reponses   ReponseUtilisateur[]

  @@map("options_reponse")
}

model ResultatTest {
  id             String               @id @default(uuid())
  testId         String
  etudiantId     Int
  score          Int
  interpretation String?              @db.Text
  datePassation  DateTime             @default(now())
  rapportId      String?
  test           TestPsychologique    @relation(fields: [testId], references: [id], onDelete: Cascade)
  etudiant       Etudiant             @relation(fields: [etudiantId], references: [id_etudiant], onDelete: Cascade)
  rapport        Rapport?             @relation("RapportToResultatTest", fields: [rapportId], references: [id], onDelete: SetNull)
  reponses       ReponseUtilisateur[]

  @@map("resultats_test")
}

model ReponseUtilisateur {
  id         String         @id @default(uuid())
  resultatId String
  questionId String
  optionId   String?
  texteLibre String?        @db.Text
  resultat   ResultatTest   @relation(fields: [resultatId], references: [id], onDelete: Cascade)
  question   Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  option     OptionReponse? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@map("reponses_utilisateur")
}

model Rapport {
  id             String         @id @default(dbgenerated("gen_random_uuid()"))
  etudiantId     Int
  psychologueId  Int?
  titre          String
  description    String?        @db.Text
  commentaires   String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  etudiant       Etudiant       @relation(fields: [etudiantId], references: [id_etudiant], onDelete: Cascade)
  psychologue    Psychologue?   @relation("PsychologueToRapport", fields: [psychologueId], references: [id_psychologue], onDelete: SetNull)
  rapportEntries RapportEntry[] @relation("RapportToRapportEntry")
  resultatTests  ResultatTest[] @relation("RapportToResultatTest")

  @@map("rapport")
}

model RapportEntry {
  id               String    @id @default(dbgenerated("gen_random_uuid()"))
  rapportId        String
  dateconsultation DateTime
  resume           String?   @db.Text
  observations     String?   @db.Text
  rapport          Rapport   @relation("RapportToRapportEntry", fields: [rapportId], references: [id], onDelete: Cascade)

  @@map("rapport_entry")
}

model Notification {
  id             Int           @id @default(autoincrement())
  userId         Int
  message        String        @db.Text
  date           DateTime      @default(now())
  read           Boolean       @default(false)
  userMessageId  String?
  rendezVousId   Int?
  conversationId Int?
  user           utilisateur   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userMessage    UserMessage?  @relation(fields: [userMessageId], references: [id], onDelete: Cascade)
  rendezVous     RendezVous?   @relation(fields: [rendezVousId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  administrateurId Int?
  administrateur  Administrateur? @relation(fields: [administrateurId], references: [id], onDelete: SetNull)

  @@index([userMessageId])
  @@index([rendezVousId])
  @@index([conversationId])
  @@index([administrateurId])
}
enum ConsultationStatus {
  REQUESTED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RoleEnum {
  PSYCHOLOGUE
  ETUDIANT
}

enum CiviliteEnum {
  M
  Mme
}

enum TypeConsultation {
  PRESENTIEL
  EN_LIGNE
  LES_DEUX
}

enum CategorieTest {
  ANXIETE
  DEPRESSION
  STRESS
  PERSONNALITE
  ORIENTATION_PROFESSIONNELLE
  APPRENTISSAGE
  TDAH
  BIEN_ETRE
}


enum TypeQuestion {
  CHOIX_UNIQUE
  CHOIX_MULTIPLE
  ECHELLE_LIKERT
  TEXTE_LIBRE
  ECHELLE_INTENSITE
  ECHELLE_FREQUENCE
  ECHELLE_ACCORD
  ECHELLE_INTERET
}